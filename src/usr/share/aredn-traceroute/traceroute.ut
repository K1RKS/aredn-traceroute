{%
/*
 * Tools → Traceroute dialog (aredn-traceroute drop-in).
 * Based on AREDN firmware tools/e/traceroute.ut; adds Copy of console text.
 * Marker: aredn-traceroute-ui
 */
%}
{%
const nodes = mesh.getNodeList();
const mynode = configuration.getName();
%}
<div class="dialog wide">
    {{_R("tool-header", "Traceroute")}}
    <div class="simple-tool compact client-server">
        <div class="cols">
            <div>
                <div class="o">Target A&zwnj;ddress</div>
                <div class="m">IP A&zwnj;ddress, Hostname or Node</div>
            </div>
            <div>
                <input id="tool-target" type="text" size="40" required list="mesh-nodes">
                <button id="target-swap"><div class="icon updownarrow"></div></button>
            </div>
        </div>
        <div class="cols">
            <div>
                <div class="o">Source A&zwnj;ddress</div>
                <div class="m">Node name or a&zwnj;ddress</div>
            </div>
            <div>
                <input id="tool-client" type="text" size="40" required value="{{mynode}}" list="mesh-nodes">
                <div id="target-swap-dummy" style="width:42px"></div>
            </div>
        </div>
        <datalist id="mesh-nodes">
            <option value="{{mynode}}">{{mynode}}</option>
            {%
                for (let i = 0; i < length(nodes); i++) {
                    const nn = nodes[i].name;
                    if (nn !== mynode) {
                        print(`<option value="${nn}">${nn}</option>`);
                    }
                }
            %}
        </datalist>
        {{_H("Trace the route between a source host and a target. The source should be node on the mesh, and by default is the current node.
        The target can be a node, an IP address, or any hostname that might be reachable. Use Copy after a run to put the console text on the clipboard.")}}
        <div class="cols">
            <div class="tool-console">
                <pre></pre>
            </div>
            <div>
                <button id="tool-start">Go</button>
            </div>
        </div>
    </div>
    <div class="ctrl-modal-footer">
        <hr/>
        <div style="display:flex;gap:8px;justify-content:flex-end;align-items:center;flex-wrap:wrap">
            <button id="tool-copy" type="button" disabled title="Copy console output">Copy</button>
            <button id="dialog-done" onclick="setTimeout(_ => document.getElementById('ctrl-modal').close(), 10)">Done</button>
        </div>
    </div>
    <script>
    (function(){
        {{_R("open")}}
        {% if (!request.mobile) { %}
        htmx.find("#tool-target").focus();
        {% } %}
        const mynode = "{{mynode}}";
        const btnCopy = htmx.find("#tool-copy");
        function setCopyEnabled(on) {
            btnCopy.disabled = !on;
        }
        function consoleEl() {
            return htmx.find("#ctrl-modal .tool-console pre");
        }
        function consoleText() {
            const con = consoleEl();
            return (con && con.innerText) ? con.innerText.replace(/\s+$/, "") : "";
        }
        function selectConsole() {
            const con = consoleEl();
            if (!con) {
                return false;
            }
            const sel = window.getSelection();
            const range = document.createRange();
            range.selectNodeContents(con);
            sel.removeAllRanges();
            sel.addRange(range);
            return true;
        }
        // Mesh UI is http:// (not a secure context), so navigator.clipboard is
        // usually unavailable. Prefer execCommand; fall back to opening text.
        function copyConsoleToClipboard() {
            const text = consoleText();
            if (!text) {
                return "empty";
            }
            // 1) copy event + execCommand (no selection required)
            let filled = false;
            const onCopy = (e) => {
                try {
                    e.clipboardData.setData("text/plain", text);
                    e.preventDefault();
                    filled = true;
                }
                catch (_) {}
            };
            document.addEventListener("copy", onCopy);
            try {
                if (document.execCommand("copy") || filled) {
                    return "copied";
                }
            }
            catch (_) {}
            finally {
                document.removeEventListener("copy", onCopy);
            }
            // 2) Select console <pre> (same as manual select) then copy
            try {
                if (selectConsole() && document.execCommand("copy")) {
                    window.getSelection().removeAllRanges();
                    return "copied";
                }
            }
            catch (_) {}
            // 3) Off-screen textarea
            try {
                const ta = document.createElement("textarea");
                ta.value = text;
                ta.setAttribute("readonly", "");
                ta.style.position = "fixed";
                ta.style.top = "0";
                ta.style.left = "0";
                ta.style.width = "1px";
                ta.style.height = "1px";
                ta.style.opacity = "0";
                document.body.appendChild(ta);
                ta.focus();
                ta.select();
                ta.setSelectionRange(0, ta.value.length);
                const ok = document.execCommand("copy");
                ta.remove();
                if (ok) {
                    return "copied";
                }
            }
            catch (_) {}
            // 4) Leave console selected so Ctrl/Cmd+C works, and open plain text
            //    (same idea as Tools → Tunnels clipboard helper).
            try {
                selectConsole();
            }
            catch (_) {}
            try {
                const url = URL.createObjectURL(new Blob([text], { type: "text/plain" }));
                const w = window.open(url, "_blank");
                if (w) {
                    setTimeout(() => URL.revokeObjectURL(url), 60000);
                    return "opened";
                }
            }
            catch (_) {}
            return "selected";
        }
        htmx.on("#target-swap", "click", _ => {
            const v = htmx.find("#tool-target").value;
            htmx.find("#tool-target").value = htmx.find("#tool-client").value;
            htmx.find("#tool-client").value = v;
        });
        htmx.on("#tool-copy", "click", _ => {
            const result = copyConsoleToClipboard();
            let label = "Copy";
            if (result === "copied") {
                btnCopy.textContent = "Copied";
            }
            else if (result === "opened") {
                btnCopy.textContent = "Opened";
                label = "Copy";
            }
            else if (result === "selected") {
                btnCopy.textContent = "Ctrl+C";
            }
            else {
                btnCopy.textContent = "Failed";
            }
            setTimeout(() => { btnCopy.textContent = "Copy"; }, 1500);
        });
        htmx.on("#tool-start", "click", async _ => {
            const server = htmx.find("#tool-target").value;
            const client = htmx.find("#tool-client").value;
            if (server && client) {
                setCopyEnabled(false);
                btnCopy.textContent = "Copy";
                const con = consoleEl();
                con.innerText = "";
                function out(line) {
                    con.innerHTML += `${line}\n`;
                }
                function meshHost(name) {
                    return `${name}${name.indexOf(".") == -1 ? ".local.mesh" : ""}`;
                }
                out("Traceroute test started");
                out("");
                try {
                    const host = meshHost(client);
                    const target = meshHost(server);
                    const url = `http://${host}/cgi-bin/traceroute?server=${encodeURIComponent(target)}`;
                    const r = await fetch(url);
                    const reader = r.body.getReader();
                    let state = "BEGIN";
                    for (;;) {
                        const { done, value } = await reader.read();
                        if (done) {
                            if (state !== "DONE") {
                                out("Traceroute Terminated.");
                            }
                            break;
                        }
                        const lines = String.fromCharCode.apply(null, value).split("\n");
                        lines.forEach(line => {
                            line = line.trim();
                            switch (state) {
                                case "BEGIN":
                                {
                                    const m = line.match(/<title>(.*)<\/title>/);
                                    if (m) {
                                        if (m[1] === "SUCCESS") {
                                            state = "CONNECTING";
                                            out(`Source: ${client}`);
                                            out(`Target: ${server}`);
                                            out("");
                                        }
                                        else {
                                            state = "ERROR";
                                            const m = line.match(/<pre>(.*)<\/pre>/);
                                            if (m) {
                                                out(`ERROR: ${m[1]}`);
                                                state = "DONE";
                                            }
                                        }
                                    }
                                    break;
                                }
                                case "CONNECTING":
                                    if (line.match(/^traceroute/)) {
                                        state = "PRINT";
                                        out(line.replace(".local.mesh", ""));
                                    }
                                    break;
                                case "PRINT":
                                    if (line) {
                                        if (line === "</pre></body></html>") {
                                            state = "DONE";
                                            out("");
                                            out("Traceroute done");
                                            out("");
                                            out(Date().toString());
                                        }
                                        else {
                                            const m = line.match(/^[0-9]+ +(.+\.local\.mesh) /);
                                            if (m) {
                                                line = line.replace(m[1], `<a href="http://${m[1]}">${m[1].replace(".local.mesh", "")}</a>`);
                                            }
                                            out(line);
                                        }
                                    }
                                    break;
                                case "ERROR":
                                {
                                    const m = line.match(/<pre>(.*)<\/pre>/);
                                    if (m) {
                                        out(`ERROR: ${m[1]}`);
                                        state = "DONE";
                                    }
                                    break;
                                }
                                case "DONE":
                                default:
                                    break;
                            }
                        });
                    }
                }
                catch (_) {
                    out("Traceroute Failed.");
                }
                if (consoleText()) {
                    setCopyEnabled(true);
                }
            }
        });
    })();
    </script>
</div>

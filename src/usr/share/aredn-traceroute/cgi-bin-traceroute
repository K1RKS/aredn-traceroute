#!/usr/bin/ucode
/*
 * Drop-in replacement for AREDN /cgi-bin/traceroute.
 * Same HTML/streaming contract as firmware CGI so Tools → Traceroute keeps working.
 * Banner (version / Babel metric) is emitted after the stock "traceroute to …" line
 * so the Tools UI, which skips pre-banner lines, still displays it.
 *
 * Query flags:
 *   verbose=1, gps=1, node_version=1, format=json
 *   tx_rx_info=0 or no_tx_rx_info=1  (tx/rx fields on by default)
 */

import * as configuration from "aredn.configuration";
import * as atr from "aredn_traceroute";

const node = configuration.getName();

const q = getenv("QUERY_STRING") || "";
const m = match(q, /server=([^&]*)/);
let server = m && m[1];
const verbose = match(q, /(^|&)verbose=1(&|$)/) ? true : false;
const gps = match(q, /(^|&)gps=1(&|$)/) ? true : false;
const nodeVersion = match(q, /(^|&)node_version=1(&|$)/) ? true : false;
const txRxInfo = match(q, /(^|&)(tx_rx_info=0|no_tx_rx_info=1)(&|$)/) ? false : true;
const wantJson = match(q, /(^|&)format=json(&|$)/) ? true : false;

if (wantJson) {
    print("Content-type: application/json\r\n");
}
else {
    print("Content-type: text/html\r\n");
}
print("Cache-Control: no-store\r\n");
print("Access-Control-Allow-Origin: *\r\n");
print("\r\n");

if (!server) {
    if (wantJson) {
        print(sprintf("%J\n", {
            schemaVersion: 1,
            tool: "aredn-traceroute",
            error: "Provide a server name [/cgi-bin/traceroute?server=<ServerName>&format=json]"
        }));
    }
    else {
        print("<html><head><title>ERROR</title></head><body><pre>Provide a server name to run a test between this client and a server [/cgi-bin/traceroute?server=&lt;ServerName&gt;</pre></body></html>\n");
    }
}
else if (match(server, /[^0-9a-zA-Z.\-]/)) {
    if (wantJson) {
        print(sprintf("%J\n", {
            schemaVersion: 1,
            tool: "aredn-traceroute",
            error: "Illegal server name"
        }));
    }
    else {
        print("<html><head><title>ERROR</title></head><body><pre>Illegal server name</pre></body></html>\n");
    }
}
else if (wantJson) {
    if (!match(server, /\./)) {
        server += ".local.mesh";
    }
    const result = atr.runEnrichedTracerouteJson(server, {
        gps: gps,
        txRxInfo: txRxInfo,
        nodeVersion: nodeVersion
    });
    const doc = result.doc;
    doc.source = atr.shortMeshName(node);
    print(sprintf("%J\n", doc));
}
else {
    if (!match(server, /\./)) {
        server += ".local.mesh";
    }
    print("<html><head><title>SUCCESS</title></head>\n");
    print("<body><pre>");
    flush();

    const destMetric = atr.lookupDestPathMetric(server);
    const headerLine = atr.formatBanner(node, server, destMetric);
    const ok = atr.runEnrichedTraceroute(server, function (line) {
        print(`${line}\n`);
        flush();
    }, {
        verbose: verbose,
        gps: gps,
        txRxInfo: txRxInfo,
        nodeVersion: nodeVersion,
        headerLine: headerLine
    });
    if (!ok) {
        print("traceroute failed\n");
    }
    print("</pre></body></html>\n");
}

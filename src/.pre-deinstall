#!/bin/sh
# Restore firmware Tools traceroute CGI + UI before package files are removed.
. /usr/share/aredn-traceroute/cgi-swap.sh 2>/dev/null || exit 0
restore_stock_cgi
restore_stock_ui
# Schedule delayed restart now (helper still on disk). Upgrade's .post-upgrade
# clears the intent and reschedules; pure remove lets this one run.
schedule_uhttpd_after_uninstall 10
exit 0
